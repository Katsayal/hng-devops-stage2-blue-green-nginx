worker_processes auto;

events {
  worker_connections 1024;
}

http {
    # Upstream configuration with ACTIVE_POOL substitution
    upstream app_upstream {
        zone upstream_zone 64k;

        # Primary / backup selection based on ACTIVE_POOL
        # ${PRIMARY} and ${BACKUP} will be substituted in entrypoint.sh
        server ${PRIMARY}:3000 max_fails=2 fail_timeout=5s;
        server ${BACKUP}:3000 backup;

        keepalive 16;
    }

    server {
        listen 80;
        server_name localhost;

        # Tight timeouts for fast failover
        proxy_connect_timeout 1s;
        proxy_send_timeout 2s;
        proxy_read_timeout 2s;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 2;

        # Forward upstream headers
        proxy_set_header X-App-Pool $upstream_http_x_app_pool;
        proxy_set_header X-Release-Id $upstream_http_x_release_id;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Routes
        location / {
            proxy_pass http://app_upstream;
        }

        location /version {
            proxy_pass http://app_upstream;
        }

        location /healthz {
            proxy_pass http://app_upstream;
        }
    }
}
